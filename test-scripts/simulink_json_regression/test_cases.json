[
  {
    "id": "SIM_READ_SPEED",
    "name": "ReadSpeedFromSimulink",
    "description": "Enter extended diagnostic session, require live Simulink updates, then read vehicle speed from vECU.",
    "steps": [
      {
        "name": "Enter extended diagnostic session",
        "request": "10 03",
        "expectedPrefix": "50 03"
      },
      {
        "name": "Require live Simulink update",
        "command": "waitForChangingResponse",
        "request": "22 01 FF",
        "expectedPrefix": "62 01 FF",
        "timeoutMs": 1500,
        "pollIntervalMs": 250
      },
      {
        "name": "Read vehicle speed",
        "request": "22 01 00",
        "expectedPrefix": "62 01 00",
        "expectedNotEquals": "62 01 00 00 00"
      }
    ]
  },
