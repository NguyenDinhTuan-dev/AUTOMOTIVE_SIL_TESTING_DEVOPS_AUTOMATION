<UserControl x:Class="AutVecu.Desktop.Views.Controls.ResultsAndLogsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0"
                  Header="Test Results"
                  FontSize="16"
                  FontWeight="SemiBold"
                  Foreground="#0B66C3"
                  Margin="0,0,10,0">
            <DataGrid ItemsSource="{Binding TestResults}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      FontSize="13"
                      Foreground="#111827">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Test Case" Binding="{Binding Name}" Width="1.35*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="92" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2.2*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Column="1"
                  Header="Logs"
                  Margin="10,0,0,0">
            <ListBox ItemsSource="{Binding Logs}"
                     FontFamily="Consolas"
                     FontSize="12" />
        </GroupBox>
    </Grid>
</UserControl>
