<UserControl x:Class="AutVecu.Desktop.Views.Controls.LiveTrafficPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GroupBox Header="Live Traffic"
              FontSize="16"
              FontWeight="SemiBold"
              Foreground="#0B66C3">
        <DataGrid ItemsSource="{Binding TrafficEntries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  FontSize="13"
                  Foreground="#111827">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="130" />
                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="110" />
                <DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="2.2*" />
                <DataGridTextColumn Header="Meaning" Binding="{Binding Meaning}" Width="2.2*" />
            </DataGrid.Columns>
        </DataGrid>
    </GroupBox>
</UserControl>
